{
  "name": "doomsday",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "description": "Doomsday - Phanter AI",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "ai.phanter.doomsday",
    "productName": "Doomsday",
    "files": [
      "main.js",
      "preload.cjs",
      "orquestrador.js",
      "roteador.js",
      "claude.js",
      "agy.js",
      "modelos.js",
      "supabase.js",
      "renderer/**/*",
      "package.json",
      ".env"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  }
}
